{
  "$schema": "./_schema.json",
  "specVersion": 1,
  "identity": {
    "languageId": "omics-interval-list",
    "displayName": "Picard Interval List",
    "aliases": ["interval_list", "Picard Intervals"],
    "extensions": [".interval_list", ".intervals"],
    "firstLine": "^@HD\\t",
    "scopeName": "source.interval-list",
    "languageConfiguration": {
      "lineComment": "@",
      "wordPattern": "[A-Za-z0-9_:.-]+"
    }
  },
  "tokenize": {
    "delimiter": "tab",
    "lineKinds": [
      {
        "name": "header",
        "kind": "regex",
        "match": "^(@[A-Z]{2})(\\t.*)?$",
        "captures": { "1": "keyword.control.header" }
      },
      {
        "name": "data",
        "kind": "columns",
        "columns": [
          { "name": "chrom", "type": "string", "scope": "string.unquoted.chrom" },
          { "name": "start", "type": "int", "scope": "constant.numeric.start" },
          { "name": "end", "type": "int", "scope": "constant.numeric.end" },
          { "name": "strand", "type": "string", "scope": "keyword.operator.strand" },
          { "name": "name", "type": "string", "scope": "entity.name.interval" }
        ]
      }
    ]
  },
  "validate": {
    "skipPrefixes": ["@"],
    "rules": [
      {
        "id": "minColumns",
        "code": "INTERVALLIST-001",
        "min": 3,
        "severity": "error",
        "message": "interval_list requires at least 3 columns (chrom, start, end)",
        "spec": {
          "href": "https://gatk.broadinstitute.org/hc/en-us/articles/360036883931-Interval-list-file-format",
          "summary": "Interval lists have a SAM-style @ header then chrom, start, end, strand, name"
        }
      },
      {
        "id": "coordinatePair",
        "code": "INTERVALLIST-002",
        "startColumn": 1,
        "endColumn": 2,
        "startName": "start",
        "endName": "end",
        "allowEqual": true,
        "severity": "error",
        "message": "start must be <= end (interval_list is 1-based, inclusive)",
        "spec": {
          "href": "https://gatk.broadinstitute.org/hc/en-us/articles/360036883931-Interval-list-file-format",
          "summary": "Coordinates are 1-based and inclusive, so start may equal end"
        }
      },
      {
        "id": "strand",
        "code": "INTERVALLIST-003",
        "column": 3,
        "values": ["+", "-"],
        "severity": "warning",
        "message": "strand must be + or -",
        "spec": {
          "href": "https://gatk.broadinstitute.org/hc/en-us/articles/360036883931-Interval-list-file-format",
          "summary": "The strand column is + or -"
        }
      }
    ]
  },
  "render": {
    "renderer": "table",
    "commentPrefixes": ["@"],
    "skipPrefixes": [],
    "columns": [
      { "key": "chrom", "label": "chrom", "type": "string", "width": 120 },
      { "key": "start", "label": "start", "type": "int", "width": 100 },
      { "key": "end", "label": "end", "type": "int", "width": 100 },
      { "key": "strand", "label": "strand", "type": "string", "width": 80 },
      { "key": "name", "label": "name", "type": "string", "width": 220 }
    ],
    "navigation": { "chromKey": "chrom", "startKey": "start", "endKey": "end", "linkColumn": "start" }
  }
}
