##FILTER=<ID=NO_ASSEMBLY,Description="No assembly supporting this variant could be found.">
##FILTER=<ID=NO_RP,Description="Variant does not have any direct read pair support.">
##FILTER=<ID=NO_SR,Description="Variant does not have any direct split read support.">
##FILTER=<ID=PASS,Description="Variant passes all filters">
##FILTER=<ID=PON,Description="Found in panel of normals">
##FILTER=<ID=REF,Description="Breakpoint corresponds to reference allele">
##FILTER=<ID=SINGLE_ASSEMBLY,Description="Only one side of the breakpoint could be assembled.">
##FILTER=<ID=SINGLE_SUPPORT,Description="Supported by fewer than 'variantcalling.minReads' fragments">
##FILTER=<ID=SMALL_EVENT,Description="Event size is smaller than the minimum reportable size specified by 'variantcalling.minSize'">
##FILTER=<ID=dedup,Description="Event is duplicate of another">
##FILTER=<ID=discordantPairSupport,Description="Large event not supported by any read pairs either directly or via assembly">
##FILTER=<ID=imprecise,Description="Imprecise variant">
##FILTER=<ID=mate,Description="Mate is filtered">
##FILTER=<ID=maxHomLengthShortInv,Description="Short inversion with significant sequence homology">
##FILTER=<ID=maxInexactHomLengthShortDel,Description="Short deletion that appears to be a ligation artifact">
##FILTER=<ID=maxNormalRelativeSupport,Description="Too many support reads from the normal sample relative to the tumor">
##FILTER=<ID=maxPolyAHomLength,Description="Homology containing long polyA or polyT run">
##FILTER=<ID=maxPolyGLength,Description="Single breakend containing long polyC or polyG run. Likely to be an artefact">
##FILTER=<ID=minLength,Description="Event is too short">
##FILTER=<ID=minNormalCoverage,Description="Insufficient normal coverage to determine somatic status">
##FILTER=<ID=minQual,Description="Insufficient quality">
##FILTER=<ID=minTumorAF,Description="Variant allele fraction too low">
##FILTER=<ID=shortSRNormalSupport,Description="Short event with split reads support in the normal sample">
##FILTER=<ID=shortSRTumorSupport,Description="Short event not supported by any split reads either directly or via assembly">
##FILTER=<ID=shortStrandBias,Description="Short event with excessive strand bias in split reads/soft clipped reads overlapping breakpoint">
